#SQLite
DB_TYPE=better-sqlite3
DB_DATABASE=./db.sqlite

#PostgreSQL
#DB_TYPE=postgres
#DB_HOST=localhost
#DB_PORT=5432
#DB_USERNAME=yourusername
#DB_PASSWORD=yourpassword
#DB_DATABASE=yourdb

#Desativar o DB_SYNCHRONIZE em produção
DB_SYNCHRONIZE=1
DB_AUTO_LOAD_ENTITIES=1

#Jwt config
JWT_SECRET='YOUR VERY SECURE SECRET VALUE'
JWT_EXPIRATION='1d'

#NestJS port on local environment
APP_PORT=3001
#Production, development, test, etc.
NODE_ENV='development'

#CORS Whitelist, separated by spaces
CORS_WHITELIST="http://localhost:3000 https://yourdomain.com"